{
	"name": "plim-ui",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "npm run build:ui && ng serve docs",
		"build:ui": "ng build ui --configuration production",
		"build:docs": "ng build docs --configuration production",
		"build:production": "npm run build:ui && npm run build:docs",
		"test:ui": "ng test ui --no-watch",
		"test:docs": "ng test docs --no-watch",
		"test": "npm run test:ui && npm run test:docs",
		"lint": "ng lint",
		"validate:tokens": "node scripts/validate-tokens.mjs"
	},
	"private": true,
	"packageManager": "npm@10.9.2",
	"dependencies": {
		"@angular/cdk": "^21.2.14",
		"@angular/common": "^21.2.0",
		"@angular/compiler": "^21.2.0",
		"@angular/core": "^21.2.0",
		"@angular/forms": "^21.2.0",
		"@angular/platform-browser": "^21.2.0",
		"@angular/router": "^21.2.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"highlight.js": "^11.12.0",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	},
	"devDependencies": {
		"@angular/build": "^21.2.21",
		"@angular/cli": "^21.2.19",
		"@angular/compiler-cli": "^21.2.0",
		"@eslint/js": "^10.0.1",
		"angular-eslint": "21.4.0",
		"eslint": "^10.3.0",
		"jsdom": "^28.0.0",
		"ng-packagr": "^21.2.0",
		"prettier": "^3.8.1",
		"typescript": "~5.9.2",
		"typescript-eslint": "8.59.2",
		"vitest": "^4.0.8"
	}
}
